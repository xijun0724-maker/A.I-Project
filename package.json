{
  "name": "journey-ai",
  "version": "1.0.0",
  "description": "AI-powered academic planning and study assistance system — syllabus analysis, task management, document retrieval and study tutoring. Runs entirely in the browser with zero server dependencies.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,md}\""
  },
  "keywords": [
    "academic",
    "planner",
    "AI",
    "study",
    "syllabus",
    "task-management",
    "student",
    "education",
    "learning",
    "RAG"
  ],
  "author": "Journey A.I Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/journey-ai/journey-ai.git"
  },
  "bugs": {
    "url": "https://github.com/journey-ai/journey-ai/issues"
  },
  "homepage": "https://github.com/journey-ai/journey-ai#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
